{
  "name": "@pitchforge/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './**' build",
    "test": "pnpm -r --filter './**' test",
    "typecheck": "pnpm -r --filter './**' typecheck",
    "lint": "eslint .",
    "ipc:generate": "node ../tools/ipcgen/generate.mjs",
    "ipc:check": "node ../tools/ipcgen/generate.mjs --check",
    "dev": "pnpm --filter @pitchforge/ui dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
