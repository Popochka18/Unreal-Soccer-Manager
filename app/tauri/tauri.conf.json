{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PitchForge",
  "version": "0.0.0",
  "identifier": "local.pitchforge.app",

  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @pitchforge/ui dev",
    "beforeBuildCommand": "pnpm --filter @pitchforge/ui build"
  },

  "app": {
    "windows": [
      {
        "title": "PitchForge",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },

  "bundle": {
    "active": false,
    "targets": "all"
  }
}
